# FilmFrame public vhost. Install this as a complete vhost file included from
# OpenResty's http context; map/upstream directives cannot live inside server.
# Keep the existing 1Panel astrocean.space certificate directives.

map $http_cookie $filmframe_session_cookie {
    default "";
    "~*(?:^|;\s*)(?<filmframe_session>__Host-filmframe_session=[^;]+)" $filmframe_session;
}

upstream filmframe_static_backend {
    server 127.0.0.1:18082;
    keepalive 16;
}

upstream filmframe_access_backend {
    server 127.0.0.1:18083;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name filmframe.astrocean.space;
    return 308 https://filmframe.astrocean.space$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name filmframe.astrocean.space;

    # Replace only these paths with the certificate paths already managed by 1Panel.
    ssl_certificate /path/to/existing/astrocean.space/fullchain.pem;
    ssl_certificate_key /path/to/existing/astrocean.space/privkey.pem;

    # Install the tracked CIDR file outside this vhost, then include its active path.
    # Only those source networks may replace $remote_addr with CF-Connecting-IP.
    include /usr/local/openresty/nginx/conf/conf.d/cloudflare-real-ip.conf;

    server_tokens off;
    client_max_body_size 16k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    if ($host != "filmframe.astrocean.space") {
        return 421;
    }

    location = /_filmframe_session_check {
        internal;
        proxy_pass http://filmframe_access_backend/internal/session-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $filmframe_session_cookie;
        proxy_set_header Host access;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_connect_timeout 1s;
        proxy_read_timeout 3s;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location = /access {
        limit_except GET {
            deny all;
        }

        proxy_pass http://filmframe_access_backend/access;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /auth/redeem {
        limit_except POST {
            deny all;
        }

        proxy_pass http://filmframe_access_backend/auth/redeem;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /auth/refresh {
        limit_except POST {
            deny all;
        }

        auth_request /_filmframe_session_check;
        error_page 401 403 = @filmframe_access_required;
        error_page 500 502 503 504 = @filmframe_auth_unavailable;

        proxy_pass http://filmframe_access_backend/auth/refresh;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    # Passkey recovery and setup are handled by the access sidecar. Recovery
    # must remain reachable without auth_request so a lost session Cookie can
    # still start WebAuthn; the sidecar performs the session check where one is
    # required.
    location = /access/passkey/setup {
        limit_except GET { deny all; }
        proxy_pass http://filmframe_access_backend/access/passkey/setup;
        proxy_set_header Cookie $filmframe_session_cookie;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /auth/passkeys/client.js {
        limit_except GET { deny all; }
        proxy_pass http://filmframe_access_backend/auth/passkeys/client.js;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering on;
        proxy_hide_header Expires;
    }

    location = /auth/passkeys/registration/options {
        limit_except POST { deny all; }
        proxy_pass http://filmframe_access_backend/auth/passkeys/registration/options;
        proxy_set_header Cookie $filmframe_session_cookie;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /auth/passkeys/registration/verify {
        limit_except POST { deny all; }
        proxy_pass http://filmframe_access_backend/auth/passkeys/registration/verify;
        proxy_set_header Cookie $filmframe_session_cookie;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /auth/passkeys/authentication/options {
        limit_except POST { deny all; }
        proxy_pass http://filmframe_access_backend/auth/passkeys/authentication/options;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /auth/passkeys/authentication/verify {
        limit_except POST { deny all; }
        proxy_pass http://filmframe_access_backend/auth/passkeys/authentication/verify;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /api/runtime-config {
        limit_except GET {
            deny all;
        }

        auth_request /_filmframe_session_check;
        error_page 401 403 = @filmframe_access_required;
        error_page 500 502 503 504 = @filmframe_auth_unavailable;

        proxy_pass http://filmframe_access_backend/api/runtime-config;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $filmframe_session_cookie;
        proxy_set_header Forwarded "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "private, no-store" always;
    }

    location = /healthz {
        return 404;
    }

    location ^~ /internal/ {
        return 404;
    }

    location / {
        auth_request /_filmframe_session_check;
        error_page 401 403 = @filmframe_access_required;
        error_page 500 502 503 504 = @filmframe_auth_unavailable;

        proxy_pass http://filmframe_static_backend;
        proxy_set_header Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Host filmframe.astrocean.space;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        # The static application never needs the opaque access credential.
        proxy_set_header Cookie "";
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header ETag;
        add_header Cache-Control "private, no-store" always;
    }

    location @filmframe_access_required {
        add_header Cache-Control "private, no-store" always;
        return 303 /access;
    }

    location @filmframe_auth_unavailable {
        default_type text/plain;
        add_header Cache-Control "private, no-store" always;
        add_header Retry-After "30" always;
        return 503 "FilmFrame access service unavailable\n";
    }
}
