# Copy this file to a server-only .env with mode 0600. Never commit the copy.
COMPOSE_PROJECT_NAME=filmframe-rc
FILMFRAME_RELEASE=1.3.0-rc.1
FILMFRAME_VERSION=1.3.0-rc.1
FILMFRAME_REVISION=838e4b0afcf5f35a285553c7e9a0cb8947e6af26
# The Compose file pins these identity values as constants; keep this copy in
# sync as an auditable declaration and do not override them at runtime.

FILMFRAME_HOST=filmframe-rc.astrocean.space
ADMIN_HOST=filmframe-rc-admin.astrocean.space
FILMFRAME_PORT=18182
FILMFRAME_ACCESS_PORT=18183
FILMFRAME_ACCESS_VOLUME=filmframe_rc_access_data

FILMFRAME_NODE_BUILD_IMAGE=node:22.23.2-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46
FILMFRAME_NGINX_IMAGE=nginx:1.30.0-alpine@sha256:0272e4604ed93c1792f03695a033a6e8546840f86e0de20a884bb17d2c924883
FILMFRAME_ACCESS_NODE_IMAGE=node:22.23.2-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46

# These are runtime configuration values, not repository secrets. Fill them
# with the candidate Cloudflare Access application values on the server only.
CF_ACCESS_TEAM_DOMAIN=replace-with-cloudflare-team-domain.example
CF_ACCESS_AUDIENCE=replace-with-rc-access-audience
CF_ACCESS_ADMIN_EMAIL=admin@example.com

# Candidate resource/log bounds mirror production defaults. They are isolated
# from the production .env and can be tuned for the test host if necessary.
FILMFRAME_MEMORY_LIMIT=128m
FILMFRAME_ACCESS_MEMORY_LIMIT=256m
FILMFRAME_CPU_LIMIT=0.50
FILMFRAME_ACCESS_CPU_LIMIT=1.00
FILMFRAME_PIDS_LIMIT=100
FILMFRAME_ACCESS_PIDS_LIMIT=128
FILMFRAME_LOG_MAX_SIZE=10m
FILMFRAME_LOG_MAX_FILES=5

# The candidate never mounts or contacts the host updater.
FILMFRAME_UPDATER_ENABLED=false
FILMFRAME_UPDATER_SOCKET=/run/filmframe-rc-updater-disabled/updater.sock
