{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zeno-cc/FilmFrame/blob/main/ops/release/manifest.schema.json",
  "title": "FilmFrame trusted release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "version",
    "commit",
    "publishedAt",
    "minUpdaterVersion",
    "images",
    "deployBundle",
    "database",
    "summaryZh",
    "provenance"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "version": { "$ref": "#/$defs/stableVersion" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "minUpdaterVersion": { "$ref": "#/$defs/stableVersion" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filmframe", "access"],
      "properties": {
        "filmframe": {
          "type": "string",
          "pattern": "^ghcr\\.io/zeno-cc/filmframe/filmframe@sha256:[0-9a-f]{64}$"
        },
        "access": {
          "type": "string",
          "pattern": "^ghcr\\.io/zeno-cc/filmframe/access@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "deployBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/Zeno-cc/FilmFrame/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/filmframe-deploy-[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.gz$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaFrom", "schemaTo", "rollbackFloor", "backwardCompatible"],
      "properties": {
        "schemaFrom": { "type": "integer", "minimum": 1, "maximum": 999 },
        "schemaTo": { "type": "integer", "minimum": 1, "maximum": 999 },
        "rollbackFloor": { "$ref": "#/$defs/stableVersion" },
        "backwardCompatible": { "const": true }
      }
    },
    "summaryZh": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "enum": ["feature", "fix", "security"] },
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120,
            "pattern": "^(?=.*[\\u3400-\\u9fff])[^<>\\r\\n\\u0000-\\u001f]+$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "repository", "workflow", "ref"],
      "properties": {
        "issuer": { "const": "https://token.actions.githubusercontent.com" },
        "repository": { "const": "Zeno-cc/FilmFrame" },
        "workflow": { "const": ".github/workflows/release.yml" },
        "ref": {
          "type": "string",
          "pattern": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  },
  "$defs": {
    "stableVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
