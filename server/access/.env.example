NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/data/access.sqlite
FILMFRAME_HOST=filmframe.example.com
ADMIN_HOST=filmframe-admin.example.com
INTERNAL_HOSTS=access,localhost,127.0.0.1
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-access-application-audience
CF_ACCESS_ADMIN_EMAIL=admin@example.com
SECURE_COOKIES=true
FILMFRAME_UPDATER_ENABLED=false
FILMFRAME_UPDATER_SOCKET=/run/filmframe-updater/updater.sock
FILMFRAME_UPDATER_TIMEOUT_MS=3000
