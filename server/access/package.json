{
  "name": "@filmframe/access-service",
  "version": "1.4.12",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm test && npm run typecheck && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "\"$npm_node_execpath\" --import tsx --test --test-concurrency=1 tests/all.test.ts",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "better-sqlite3": "12.11.1",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jose": "6.2.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.19.7",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.27.7": true
  }
}
