{
  "name": "film-frame-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:geometry": "vitest run tests/filmGeometry.test.ts",
    "test:preview": "vitest run tests/previewNavigation.test.ts",
    "test:settings": "vitest run tests/settingsStorage.test.ts",
    "test:upload": "vitest run tests/uploadFiles.test.ts",
    "test:download": "vitest run tests/previewDownload.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run typecheck && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "exif-js": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
