COMPOSE_PROJECT_NAME=filmframe
FILMFRAME_PORT=18082
FILMFRAME_ACCESS_PORT=18083
FILMFRAME_RELEASE=local
FILMFRAME_REVISION=uncommitted
# Production cutover must use registry@sha256 digests or local sha256 image IDs.
FILMFRAME_IMAGE=filmframe:local
FILMFRAME_ACCESS_IMAGE=filmframe-access:local
FILMFRAME_NODE_BUILD_IMAGE=node:22.23.2-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46
FILMFRAME_NGINX_IMAGE=nginx:1.30.0-alpine@sha256:0272e4604ed93c1792f03695a033a6e8546840f86e0de20a884bb17d2c924883
FILMFRAME_ACCESS_NODE_IMAGE=node:22.23.2-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46
FILMFRAME_ACCESS_VOLUME=filmframe_access_data
FILMFRAME_BACKUP_DIR=/opt/filmframe/backups/access
FILMFRAME_MEMORY_LIMIT=128m
FILMFRAME_ACCESS_MEMORY_LIMIT=256m
FILMFRAME_CPU_LIMIT=0.50
FILMFRAME_ACCESS_CPU_LIMIT=1.00
FILMFRAME_PIDS_LIMIT=100
FILMFRAME_ACCESS_PIDS_LIMIT=128
FILMFRAME_LOG_MAX_SIZE=10m
FILMFRAME_LOG_MAX_FILES=5
FILMFRAME_HOST=filmframe.astrocean.space
ADMIN_HOST=filmframe-admin.astrocean.space
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-the-admin-application-audience
CF_ACCESS_ADMIN_EMAIL=replace-with-the-exact-admin-email
# Keep disabled until the host updater is installed and its rollback rehearsal passes.
FILMFRAME_UPDATER_ENABLED=false
FILMFRAME_UPDATER_GID=10001
FILMFRAME_UPDATER_TIMEOUT_MS=3000
